# irctc.dev API Configuration
# Claim 10,000 Free Credits on 1-click Google signup at https://irctc.dev/dashboard
IRCTC_API_KEY=your_irctc_api_key_here

# API Gateway Base URL (Default: https://api.irctc.dev)
IRCTC_API_BASE_URL=https://api.irctc.dev

# Telegram Bot Credentials
# Create your bot via @BotFather on Telegram to get your bot token
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Your personal Telegram chat ID or group ID (Get it by messaging @userinfobot)
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Train Monitoring Configuration
WATCH_TRAIN_NO=12557
WATCH_STATION=NKE
WATCH_CLASS=ALL
POLL_INTERVAL_SECONDS=120
